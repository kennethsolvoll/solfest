# Copy to .env and fill in from your Supabase project settings (API).
# .env is gitignored. Never commit real keys.

# Public — these ship in the browser bundle by design and are protected by RLS.
NUXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-side only, for scripts/seed.mjs. Bypasses RLS — treat as a password.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
