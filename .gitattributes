# Normalize all text files to LF in the repository.
# Working copies on Windows still get CRLF where the tool needs it.
* text=auto eol=lf

# Binary assets: never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.TTF  binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
